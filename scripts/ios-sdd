#!/bin/bash
# ios-sdd — CLI helper to apply and verify ios-sdd-template inside a freshly created Xcode project.

set -euo pipefail

BOLD=$(tput bold 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
NC="\033[0m"

ok() { echo -e "${GREEN}✔${NC} $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
fail() { echo -e "${RED}✘${NC} $1"; }
info() { echo "→ $1"; }

resolve_script_path() {
  local source="$1"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="$dir/$source" ;;
    esac
  done
  cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_path "${BASH_SOURCE[0]}")"
TEMPLATE_DIR="${IOS_SDD_TEMPLATE_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"

usage() {
  cat <<'EOF'
ios-sdd — iOS Spec Driven Development template helper

Usage:
  ios-sdd init [path] [--app-name NAME] [--yes] [--skip-verify] [--no-specify] [--no-hooks] [--no-source]
  ios-sdd verify [path] [--scheme NAME] [--destination DESTINATION]
  ios-sdd doctor [path]
  ios-sdd help

Recommended new app flow:
  # 1) Create an iOS App in Xcode: SwiftUI · Swift · Swift Testing
  # 2) Then from Terminal:
  cd ~/Developer/MyApp
  ios-sdd init
  ios-sdd verify
  claude --model opusplan

Environment:
  IOS_SDD_TEMPLATE_DIR  Override template repo path when running an installed copy.
  SCHEME                Override Xcode scheme for verify.
  DESTINATION           Override xcodebuild destination for verify.
EOF
}

require_template() {
  if [ ! -d "$TEMPLATE_DIR" ] || [ ! -f "$TEMPLATE_DIR/CLAUDE.md" ]; then
    fail "Template dir not found or incomplete: $TEMPLATE_DIR"
    echo "Set IOS_SDD_TEMPLATE_DIR=/path/to/ios-sdd-template or run from the template repo."
    exit 1
  fi
}

abs_dir() {
  local dir="$1"
  if [ ! -d "$dir" ]; then
    fail "Directory does not exist: $dir"
    exit 1
  fi
  cd "$dir" && pwd
}

list_xcodeprojs() {
  local target="$1"
  find "$target" -maxdepth 1 -name '*.xcodeproj' -type d -print | sort
}

detect_app_name() {
  local target="$1"
  local explicit="${2:-}"
  if [ -n "$explicit" ]; then
    printf '%s\n' "$explicit"
    return 0
  fi

  local projects count project
  projects="$(list_xcodeprojs "$target")"
  count="$(printf '%s\n' "$projects" | sed '/^$/d' | wc -l | tr -d ' ')"
  if [ "$count" = "1" ]; then
    project="$(printf '%s\n' "$projects" | sed '/^$/d' | head -1)"
    basename "$project" .xcodeproj
    return 0
  fi

  if [ "$count" -gt 1 ]; then
    fail "Found multiple .xcodeproj files. Re-run with --app-name NAME."
    printf '%s\n' "$projects" | sed 's/^/  - /'
    exit 1
  fi

  # Last-resort fallback: current directory name.
  basename "$target"
}

detect_app_source_dir() {
  local target="$1"
  local app_name="$2"
  if [ -d "$target/$app_name" ]; then
    printf '%s\n' "$target/$app_name"
    return 0
  fi

  local candidate
  candidate="$(find "$target" -maxdepth 2 -name '*App.swift' -type f -print | head -1 | xargs dirname 2>/dev/null || true)"
  if [ -n "$candidate" ] && [ -d "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  printf '%s\n' ""
}

detect_tests_dir() {
  local target="$1"
  local app_name="$2"
  if [ -d "$target/${app_name}Tests" ]; then
    printf '%s\n' "$target/${app_name}Tests"
    return 0
  fi

  local candidate
  candidate="$(find "$target" -maxdepth 1 -type d -name '*Tests' -print | head -1 || true)"
  printf '%s\n' "$candidate"
}

backup_path() {
  local path="$1"
  local stamp
  stamp="$(date +%Y%m%d-%H%M%S)"
  printf '%s\n' "$path.backup-before-ios-sdd-$stamp"
}

copy_file_with_backup() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [ -f "$dst" ]; then
    if cmp -s "$src" "$dst"; then
      ok "unchanged $(basename "$dst")"
      return 0
    fi
    local bak
    bak="$(backup_path "$dst")"
    cp "$dst" "$bak"
    warn "backed up existing $(basename "$dst") to $(basename "$bak")"
  fi
  cp "$src" "$dst"
  ok "installed ${dst#$PWD/}"
}

copy_dir_overlay() {
  local src="$1"
  local dst="$2"
  if [ ! -d "$src" ]; then
    return 0
  fi
  mkdir -p "$dst"
  rsync -a --ignore-existing "$src/" "$dst/"
  ok "overlay installed ${dst#$PWD/}"
}

replace_placeholders() {
  local target="$1"
  local app_name="$2"
  local escaped
  escaped="$(printf '%s' "$app_name" | sed 's/[\\&/]/\\&/g')"

  local files=()
  while IFS= read -r f; do files+=("$f"); done < <(
    find "$target" \
      \( -path '*/.git/*' -o -path '*/DerivedData/*' \) -prune -o \
      -type f \( -name '*.md' -o -name '*.sh' -o -name '*.yml' -o -name '*.yaml' -o -name '*.json' -o -name '*.swift' -o -name '*.txt' \) -print
  )
  if [ "${#files[@]}" -gt 0 ]; then
    perl -pi -e "s/__APP_NAME__/$escaped/g" "${files[@]}"
  fi
}

run_specify_init() {
  local target="$1"
  if command -v specify >/dev/null 2>&1; then
    info "Initializing Spec Kit for Claude Code"
    (cd "$target" && specify init . --force --integration claude) || {
      warn "specify init failed. Continuing with template overlay; you can retry: specify init . --force --integration claude"
    }
  else
    warn "Spec Kit CLI not found. Run ios-sdd doctor for install hints, or run template scripts/bootstrap.sh."
  fi
}

install_git_hooks() {
  local target="$1"
  if [ -d "$target/.git" ] && [ -f "$target/scripts/install-git-hooks.sh" ]; then
    info "Installing local git hooks"
    (cd "$target" && bash scripts/install-git-hooks.sh) || warn "Could not install hooks; retry with: bash scripts/install-git-hooks.sh"
  fi
}

init_git_if_needed() {
  local target="$1"
  if [ ! -d "$target/.git" ]; then
    info "Initializing git repository"
    git -C "$target" init -q
    ok "git initialized"
  else
    ok "git already initialized"
  fi
}

copy_overlay() {
  local target="$1"
  copy_dir_overlay "$TEMPLATE_DIR/.claude" "$target/.claude"
  copy_dir_overlay "$TEMPLATE_DIR/.specify" "$target/.specify"
  copy_dir_overlay "$TEMPLATE_DIR/specs" "$target/specs"
  copy_dir_overlay "$TEMPLATE_DIR/docs" "$target/docs"
  copy_dir_overlay "$TEMPLATE_DIR/scripts" "$target/scripts"
  copy_dir_overlay "$TEMPLATE_DIR/.github/workflows" "$target/.github/workflows"

  # The template constitution is the source of truth; re-apply it after `specify init`,
  # because Spec Kit may create a generic constitution first.
  if [ -f "$TEMPLATE_DIR/.specify/memory/constitution.md" ]; then
    copy_file_with_backup "$TEMPLATE_DIR/.specify/memory/constitution.md" "$target/.specify/memory/constitution.md"
  fi

  copy_file_with_backup "$TEMPLATE_DIR/CLAUDE.md" "$target/CLAUDE.md"
  [ -f "$TEMPLATE_DIR/AGENTS.md" ] && copy_file_with_backup "$TEMPLATE_DIR/AGENTS.md" "$target/AGENTS.md"
  [ -f "$TEMPLATE_DIR/.swiftformat" ] && copy_file_with_backup "$TEMPLATE_DIR/.swiftformat" "$target/.swiftformat"
  [ -f "$TEMPLATE_DIR/.swiftlint.yml" ] && copy_file_with_backup "$TEMPLATE_DIR/.swiftlint.yml" "$target/.swiftlint.yml"
  if [ ! -f "$target/.gitignore" ] && [ -f "$TEMPLATE_DIR/.gitignore" ]; then
    cp "$TEMPLATE_DIR/.gitignore" "$target/.gitignore"
    ok "installed .gitignore"
  fi
}

copy_source_template() {
  local target="$1"
  local app_name="$2"
  local source_dir="$3"
  local tests_dir="$4"

  if [ -n "$source_dir" ] && [ -d "$source_dir" ]; then
    info "Installing source scaffold into ${source_dir#$target/}"
    copy_dir_overlay "$TEMPLATE_DIR/SourceTemplate" "$source_dir"
  else
    warn "Could not find app source folder for '$app_name'. Skipping SourceTemplate copy."
    echo "Expected '$target/$app_name' or a folder containing *App.swift."
  fi

  if [ -n "$tests_dir" ] && [ -d "$tests_dir" ] && [ -f "$TEMPLATE_DIR/Tests/ExampleFeatureTests.swift" ]; then
    info "Installing example Swift Testing test into ${tests_dir#$target/}"
    local dst="$tests_dir/ExampleFeatureTests.swift"
    if [ ! -f "$dst" ]; then
      cp "$TEMPLATE_DIR/Tests/ExampleFeatureTests.swift" "$dst"
      ok "installed ${dst#$target/}"
    else
      ok "example test already exists"
    fi
  else
    warn "Could not find tests folder. Skipping ExampleFeatureTests.swift."
  fi
}

cmd_init() {
  require_template
  local target="."
  local app_name=""
  local yes=0
  local skip_verify=0
  local no_specify=0
  local no_hooks=0
  local no_source=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app-name)
        app_name="${2:-}"; shift 2 ;;
      --app-name=*)
        app_name="${1#*=}"; shift ;;
      --yes|-y)
        yes=1; shift ;;
      --skip-verify)
        skip_verify=1; shift ;;
      --no-specify)
        no_specify=1; shift ;;
      --no-hooks)
        no_hooks=1; shift ;;
      --no-source)
        no_source=1; shift ;;
      --help|-h)
        usage; exit 0 ;;
      --*)
        fail "Unknown option: $1"; usage; exit 1 ;;
      *)
        target="$1"; shift ;;
    esac
  done

  target="$(abs_dir "$target")"
  app_name="$(detect_app_name "$target" "$app_name")"
  local source_dir tests_dir xcodeprojs
  source_dir="$(detect_app_source_dir "$target" "$app_name")"
  tests_dir="$(detect_tests_dir "$target" "$app_name")"
  xcodeprojs="$(list_xcodeprojs "$target")"

  echo "${BOLD}iOS SDD init${RESET}"
  echo "Project root: $target"
  echo "Template:     $TEMPLATE_DIR"
  echo "App name:     $app_name"
  [ -n "$xcodeprojs" ] && printf 'Xcodeproj:     %s\n' "$(printf '%s' "$xcodeprojs" | paste -sd ', ' -)" || warn "No .xcodeproj found at project root"
  [ -n "$source_dir" ] && echo "Source dir:   ${source_dir#$target/}" || true
  [ -n "$tests_dir" ] && echo "Tests dir:    ${tests_dir#$target/}" || true
  echo ""

  if [ "$yes" != "1" ]; then
    read -rp "Apply ios-sdd template overlay here? [Y/n] " answer
    case "${answer:-Y}" in
      Y|y|yes|YES) ;;
      *) echo "Cancelled."; exit 0 ;;
    esac
  fi

  init_git_if_needed "$target"
  if [ "$no_specify" != "1" ]; then
    run_specify_init "$target"
  fi

  info "Installing SDD overlay"
  copy_overlay "$target"
  replace_placeholders "$target" "$app_name"

  if [ "$no_source" != "1" ]; then
    copy_source_template "$target" "$app_name" "$source_dir" "$tests_dir"
    replace_placeholders "$target" "$app_name"
  fi

  if [ "$no_hooks" != "1" ]; then
    install_git_hooks "$target"
  fi

  echo ""
  ok "ios-sdd init finished"

  if [ "$skip_verify" != "1" ]; then
    echo ""
    info "Running ios-sdd verify"
    if "$0" verify "$target" --scheme "$app_name"; then
      ok "baseline verification passed"
    else
      warn "baseline verification did not pass. Run 'ios-sdd doctor' and then 'ios-sdd verify' after fixing blockers."
    fi
  else
    echo "Skipped verification. Run: ios-sdd verify"
  fi

  cat <<EOF

Next:
  cd "$target"
  claude --model opusplan

Inside Claude Code:
  /speckit.constitution
  /constitution
  /speckit.specify <your first feature>
EOF
}

cmd_doctor() {
  require_template
  local target="${1:-.}"
  target="$(abs_dir "$target")"
  local app_name source_dir tests_dir
  app_name="$(detect_app_name "$target" "")"
  source_dir="$(detect_app_source_dir "$target" "$app_name")"
  tests_dir="$(detect_tests_dir "$target" "$app_name")"

  echo "${BOLD}iOS SDD doctor${RESET}"
  echo "Project root: $target"
  echo "Template:     $TEMPLATE_DIR"
  echo "App name:     $app_name"

  [ -n "$(list_xcodeprojs "$target")" ] && ok ".xcodeproj found" || warn "no .xcodeproj found"
  [ -n "$source_dir" ] && ok "source dir: ${source_dir#$target/}" || warn "source dir not found"
  [ -n "$tests_dir" ] && ok "tests dir: ${tests_dir#$target/}" || warn "tests dir not found"
  [ -d "$target/.specify" ] && ok ".specify installed" || warn ".specify missing"
  [ -f "$target/.specify/memory/constitution.md" ] && ok "constitution.md installed" || warn "constitution.md missing"
  [ -d "$target/.claude/commands" ] && ok "Claude commands installed" || warn "Claude commands missing"
  [ -f "$target/scripts/verify.sh" ] && ok "verify.sh installed" || warn "scripts/verify.sh missing"

  echo ""
  echo "${BOLD}Tools${RESET}"
  local tools=(xcodebuild swiftformat swiftlint xcbeautify specify claude git rsync perl)
  local tool
  for tool in "${tools[@]}"; do
    if command -v "$tool" >/dev/null 2>&1; then
      ok "$tool"
    else
      warn "$tool not found"
    fi
  done

  echo ""
  echo "Install/fix hints:"
  echo "  bash \"$TEMPLATE_DIR/scripts/bootstrap.sh\""
  echo "  ios-sdd init"
  echo "  ios-sdd verify"
}

cmd_verify() {
  local target="."
  local scheme="${SCHEME:-}"
  local destination="${DESTINATION:-}"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --scheme)
        scheme="${2:-}"; shift 2 ;;
      --scheme=*)
        scheme="${1#*=}"; shift ;;
      --destination)
        destination="${2:-}"; shift 2 ;;
      --destination=*)
        destination="${1#*=}"; shift ;;
      --help|-h)
        usage; exit 0 ;;
      --*)
        fail "Unknown option: $1"; usage; exit 1 ;;
      *)
        target="$1"; shift ;;
    esac
  done

  target="$(abs_dir "$target")"
  if [ -z "$scheme" ]; then
    scheme="$(detect_app_name "$target" "")"
  fi

  if [ ! -f "$target/scripts/verify.sh" ]; then
    fail "scripts/verify.sh not found. Run ios-sdd init first."
    exit 1
  fi

  if [ ! -d "$target/.git" ]; then
    warn "No git repo found; initializing git because scripts/verify.sh expects one."
    git -C "$target" init -q
  fi

  echo "${BOLD}iOS SDD verify${RESET}"
  echo "Project root: $target"
  echo "Scheme:       $scheme"
  [ -n "$destination" ] && echo "Destination:  $destination"
  echo ""

  if [ -n "$destination" ]; then
    (cd "$target" && SCHEME="$scheme" DESTINATION="$destination" bash scripts/verify.sh)
  else
    (cd "$target" && SCHEME="$scheme" bash scripts/verify.sh)
  fi
}

cmd_install() {
  require_template
  local bin_dir="${HOME}/.local/bin"
  mkdir -p "$bin_dir"
  ln -sf "$TEMPLATE_DIR/scripts/ios-sdd" "$bin_dir/ios-sdd"
  ok "installed symlink: $bin_dir/ios-sdd"
  case ":$PATH:" in
    *":$bin_dir:"*) ok "$bin_dir is already in PATH" ;;
    *) warn "$bin_dir is not in PATH. Add this to your shell profile: export PATH=\"$bin_dir:\$PATH\"" ;;
  esac
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init) cmd_init "$@" ;;
    verify) cmd_verify "$@" ;;
    doctor) cmd_doctor "$@" ;;
    install) cmd_install "$@" ;;
    help|--help|-h) usage ;;
    *) fail "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
